# Public local-test configuration only; never use these credentials in deployment.
COMPOSE_PROJECT_NAME=corplunch-tests
APP_ENV_FILE=./tests/.env.test
DB_BIND=127.0.0.1:15432
API_BIND=127.0.0.1:18000
WEB_BIND=127.0.0.1:15173
DATABASE_URL=postgresql+asyncpg://corplunch:corplunch@db:5432/corplunch
JWT_SECRET=local-tests-only-not-for-deployment
JWT_EXPIRE_MINUTES=480
MEALTY_CITY=Москва
CUTOFF_TIME=16:00
